{
  "id": "toolbox",
  "name": "Toolbox",
  "description": "Personal desktop toolbox for DMS & Niri",
  "version": "0.1.0",
  "author": "tttsaurus",
  "icon": "widgets",

  "type": "composite",
  "capabilities": [
    "dankbar-widget",
    "daemon"
